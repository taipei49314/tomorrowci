{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomorrowci.dev/schemas/config-v1.json",
  "title": "TomorrowCIConfig",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "candidates": {
      "$ref": "#/$defs/candidates"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "sandbox": {
      "$ref": "#/$defs/sandbox"
    },
    "report": {
      "$ref": "#/$defs/report"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "patternProperties": {
    "^x[-_]": {}
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "type": "string",
          "enum": ["auto", "python", "node", "rust"],
          "default": "auto"
        },
        "test_command": {
          "type": "string",
          "default": "auto"
        },
        "build_command": {
          "type": "string",
          "const": "auto",
          "description": "Custom build commands are not implemented; include required checks in test_command.",
          "default": "auto"
        },
        "python_image_pip": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to a pip-free test venv installed with pip >=22.3 from the pinned official Python image. Requires ecosystem: python (enforced at runtime). Declare pip/setuptools/wheel in requirements if tests need them; concrete dependency snapshots do not support this option."
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "default": "auto"
        },
        "dependencies": {
          "type": "string",
          "default": "locked"
        }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "$ref": "#/$defs/runtimeCandidates"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencyCandidates"
        }
      }
    },
    "runtimeCandidates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["stable", "preview"]
        },
        "max_versions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 5
        },
        "versions": {
          "type": "array",
          "uniqueItems": true,
          "description": "Optional explicit CPython minor versions, each later than the baseline and in strictly increasing semantic order. Python only. Nonempty lists require the stable channel. The list must fit max_versions and, with the baseline, execution.max_scenarios; runtime validation enforces these cross-field constraints. An empty list disables runtime candidates; omission preserves the legacy catalogue. Image availability is checked during execution, not inferred from this list.",
          "items": {
            "type": "string",
            "pattern": "^3\\.(0|[1-9][0-9]{0,2})$(?![\\s\\S])"
          }
        }
      }
    },
    "dependencyCandidates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latest_allowed": {
          "type": "boolean",
          "default": true
        },
        "prerelease": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_scenarios": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 24
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "default": 900
        },
        "reruns_on_failure": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 2
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 2
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["auto", "docker", "podman"],
          "default": "auto"
        },
        "network": {
          "type": "string",
          "enum": ["fetch-only"],
          "default": "fetch-only"
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 4096
        },
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 2.0
        },
        "pids_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 512
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "html": {
          "type": "boolean",
          "default": true
        },
        "json": {
          "type": "boolean",
          "default": true
        },
        "sarif": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "policy": {
      "type": ["object", "null"],
      "default": {
        "fail_if": {
          "baseline_invalid": true,
          "new_future_failure": true,
          "horizon_regression": true,
          "blocked_ratio_above": 0.5
        }
      },
      "additionalProperties": false,
      "properties": {
        "fail_if": {
          "$ref": "#/$defs/failIfPolicy",
          "default": {}
        }
      }
    },
    "failIfPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_invalid": {
          "type": "boolean",
          "default": true
        },
        "new_future_failure": {
          "type": "boolean",
          "default": true
        },
        "horizon_regression": {
          "type": "boolean",
          "default": true
        },
        "blocked_ratio_above": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    }
  }
}
